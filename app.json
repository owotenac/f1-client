{
  "expo": {
    "name": "Sector F1",
    "slug": "sectorf1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sectorf1",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.owoignier.sectorf1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/logo_ios.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1b1bff",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.e2digitalstudio.sectorf1"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.e2digitalstudio.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1b1b1bff",
          "dark": {
            "backgroundColor": "#1b1b1bff"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://www.e2digitalstudio.com"
      },
      "eas": {
        "projectId": "a01e2447-5b76-4e27-b102-f03a75d4f630"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a01e2447-5b76-4e27-b102-f03a75d4f630"
    },
    "owner": "e2-digital-studio"
  }
}
